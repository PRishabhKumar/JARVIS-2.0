# ==============================================================================
# JARVIS ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and insert your personal credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Core Gemini API Key (get from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Model ID
JARVIS_MODEL=gemini-3.8-live

# Allow local mutation operations (process termination, volume/brightness/radio controls)
JARVIS_ALLOW_MUTATIONS=true

# Confirmation threshold: R1 asks confirmation for everything; R2 prompts only for critical/destructive actions
JARVIS_CONFIRMATION_THRESHOLD=R2

# Maximum allowed tool invocations per session turn
JARVIS_MAX_CALLS=50
